{
  "title": "A slug of solute spreading along a column",
  "domain": "Porous media",
  "shows": "A slug of solute filling a tenth of a column spreads by diffusion alone (D = 1e-3, no reaction or coupling): after t = 1 its profile is ½[erf((x − a)/2√(Dt)) − erf((x − b)/2√(Dt))].",
  "source": "J. Crank, The Mathematics of Diffusion, 2nd ed. (1975), §2.2, eq. 2.15.",
  "case": {
    "solver": "thmc_column1d",
    "cells": 200,
    "length": 1.0,
    "pressure_diffusivity": 0.001,
    "thermal_diffusivity": 0.001,
    "species_diffusivity": 0.001,
    "initial": [
      1.0,
      300.0,
      0.0
    ],
    "source_cells": [
      90,
      109
    ],
    "source_state": [
      1.0,
      300.0,
      1.0
    ],
    "dt": 0.001,
    "steps": 1000
  },
  "checks": [
