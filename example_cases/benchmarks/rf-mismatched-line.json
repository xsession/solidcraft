    },
    {
      "what": "S21 imag at 2000 MHz",
      "value": {
        "file": "s21.csv",
        "column": "S21_imag",
        "at": {
          "column": "frequency_Hz",
          "value": 2000000000.0
        }
      },
      "expect": -0.8892096683449818,
