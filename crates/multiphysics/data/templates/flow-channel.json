  "mesh": {"dimensions": [8, 6, 2], "lengths": {"x": 1.0, "y": 0.5, "z": 0.1}},
  "config": {"dt": 0.002, "kinematic_viscosity": 0.02, "pressure_preconditioner": "jacobi", "pressure_tolerance": 1e-10},
  "output": {"steps": 12, "output_interval": 4},
