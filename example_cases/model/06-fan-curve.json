{
  "title": "A fan blowing into a duct",
  "shows": "A fan on the duct's end face blows along its pressure–flow curve (0.1 Pa at no flow, none at 1.2 L/min) against an outlet. It settles where its curve crosses the duct's: with the duct's developed laminar resistance that is 8.0e-6 m³/s; the flow entering the duct and developing adds some resistance, so a little less.",
  "capabilities": [
    "fan_curve_v1",
    "scaled_momentum_v1"
  ],
  "steps": [
    {
      "command": "solid.box",
      "params": {
        "length": 60.0,
        "width": 11.2,
        "height": 11.2,
        "corner": [
          0,
          0,
          0
        ],
        "operation": "new",
        "body_name": "Wall"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 70.0,
        "width": 8.0,
        "height": 8.0,
        "corner": [
          -5,
          1.6,
          1.6
        ],
        "operation": "cut"
      }
    },
    {
      "command": "multiphysics.model.create",
      "params": {
        "name": "Fan in duct",
        "cell_mm": 0.8,
        "flow": {
          "kinematic_viscosity_m2_per_s": 1.5e-05,
          "density_kg_per_m3": 1.2,
          "end_time_s": 1.1,
          "converge_tolerance": 0.0002
        }
      }
    },
    {
      "command": "multiphysics.model.condition",
      "params": {
        "id": "$study",
        "expected_revision": "$revision",
        "name": "Outlet",
        "face": {
          "body": "Wall",
          "point": [
            60.0,
            0.8,
            5.6
          ]
        },
        "role": {
          "kind": "outlet",
          "pressure_m2_per_s2": 0
        }
      }
    },
    {
      "command": "multiphysics.model.fan",
      "params": {
        "id": "$study",
        "expected_revision": "$revision",
        "name": "Fan",
        "face": {
          "body": "Wall",
          "point": [
            0,
            0.8,
            5.6
          ]
        },
        "curve": [
          [
            0.0,
            0.1
          ],
          [
            2e-05,
            0.0
          ]
        ]
      }
    },
    {
      "command": "multiphysics.model.goal",
      "params": {
        "id": "$study",
        "expected_revision": "$revision",
        "name": "q",
        "kind": "face_volume_flow",
        "face": {
          "body": "Wall",
          "point": [
            60.0,
            0.8,
            5.6
          ]
        }
      }
    }
  ],
  "checks": [
    {
      "what": "the fan's flow against its curve crossing the duct's laminar curve (m³/s)",
      "value": {
        "metric": "goal_q",
        "abs": true
      },
      "expect": 7.998219146518158e-06,
      "tolerance": 0.15
    }
  ]
}
