{
  "title": "An RC low-pass filter",
  "domain": "Circuits",
  "shows": "1 kΩ and 100 nF: the gain falls as −10·log₁₀(1 + (f/f_c)²) with f_c = 1/(2πRC) = 1.59 kHz, and a 5 V step charges the capacitor to 5·(1 − e^(−t/RC)).",
  "source": "First-order RC circuits: A. S. Sedra and K. C. Smith, Microelectronic Circuits, 7th ed. (2015), §1.6.",
  "case": {
    "solver": "spice_circuit",
    "netlist": "* RC low-pass\nV1 in 0 PULSE(0 5 0 1n 1n 1 2) AC 1\nR1 in out 1k\nC1 out 0 100n\n",
    "analyses": [
      {
        "type": "ac",
        "start_hz": 10,
        "stop_hz": 1000000.0,
        "points": 51
      },
      {
        "type": "transient",
        "dt_s": 1e-07,
        "steps": 3000,
        "method": "trapezoidal"
      }
    ],
    "probes": [
      "in",
      "out"
    ]
  },
  "checks": [
    {
      "what": "gain at 1 kHz (dB)",
      "value": {
        "file": "ac.csv",
        "column": "out_dB",
        "at": {
          "column": "frequency_Hz",
          "value": 1000.0
        }
      },
      "expect": -1.4450701162052866,
      "tolerance": 0.005
    },
    {
      "what": "gain at 10 kHz (dB)",
      "value": {
        "file": "ac.csv",
        "column": "out_dB",
        "at": {
          "column": "frequency_Hz",
          "value": 10000.0
        }
      },
      "expect": -16.072235265805517,
      "tolerance": 0.005
    },
    {
      "what": "output one time constant after the step (V)",
      "value": {
        "file": "transient.csv",
        "column": "V_out",
        "at": {
          "column": "time_s",
          "value": 9.999999999999999e-05
        }
      },
      "expect": 3.1606027941427883,
      "tolerance": 0.005
    }
  ]
}
